{
  "version": "1.0.0",
  "name": "daily-system-design-tokens",
  "description": "Material 3 Expressive tokens for Daily System — petrol blue primary, green emerald accent",
  "color": {
    "primary": {
      "main": "#1565C0",
      "light": "#42A5F5",
      "dark": "#0D47A1",
      "container": "#BBDEFB",
      "onContainer": "#0A1929"
    },
    "secondary": {
      "main": "#455A64",
      "light": "#78909C",
      "dark": "#263238"
    },
    "accent": {
      "main": "#2E7D32",
      "light": "#66BB6A",
      "dark": "#1B5E20",
      "container": "#C8E6C9"
    },
    "tertiary": {
      "main": "#F9A825",
      "light": "#FFD54F",
      "dark": "#F57F17"
    },
    "semantic": {
      "success": "#2E7D32",
      "warning": "#F57F17",
      "danger": "#C62828",
      "info": "#1565C0"
    },
    "surface": {
      "default": "#FDFDF7",
      "container": "#F5F5F0",
      "variant": "#E7E0EC",
      "outline": "#CAC4D0",
      "outlineVariant": "#79747E"
    },
    "text": {
      "primary": "#1C1B1F",
      "secondary": "#79747E",
      "disabled": "#CAC4D0"
    },
    "shadow": "#000000"
  },
  "typography": {
    "displayLarge": { "fontSize": 32, "fontWeight": 600, "height": 1.2, "letterSpacing": -0.5 },
    "displayMedium": { "fontSize": 28, "fontWeight": 600, "height": 1.2, "letterSpacing": -0.3 },
    "headlineLarge": { "fontSize": 24, "fontWeight": 600, "height": 1.3 },
    "headlineMedium": { "fontSize": 20, "fontWeight": 500, "height": 1.3 },
    "titleLarge": { "fontSize": 18, "fontWeight": 500, "height": 1.4 },
    "titleMedium": { "fontSize": 16, "fontWeight": 500, "height": 1.4 },
    "bodyLarge": { "fontSize": 16, "fontWeight": 400, "height": 1.5 },
    "bodyMedium": { "fontSize": 14, "fontWeight": 400, "height": 1.5 },
    "bodySmall": { "fontSize": 12, "fontWeight": 400, "height": 1.4, "color": "#79747E" },
    "labelLarge": { "fontSize": 14, "fontWeight": 600, "height": 1.4, "letterSpacing": 0.5 },
    "labelMedium": { "fontSize": 12, "fontWeight": 600, "height": 1.4, "letterSpacing": 0.5 }
  },
  "shape": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48
  },
  "motion": {
    "durationShort": 200,
    "durationMedium": 300,
    "durationLong": 500,
    "curveEmphasized": "Curves.easeOutCubic",
    "curveDecelerated": "Curves.easeOut",
    "curveElastic": "Curves.elasticOut"
  },
  "elevation": {
    "none": 0,
    "small": 1,
    "medium": 4,
    "large": 8,
    "shadowOpacity": 0.08
  }
}
